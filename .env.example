# 复制为 .env 并填入真实值。.env 已在 .gitignore 里，不会被提交。

# ---- Embedding：固定走阿里云百炼（DeepSeek 不提供 embedding 接口）----
# 申请：https://bailian.console.aliyun.com/  →  API-KEY
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx
# 若你的百炼账号要求业务空间隔离，改成
# https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/api/v1/services/embeddings/text-embedding/text-embedding
# DASHSCOPE_EMBED_URL=
EMBED_MODEL=text-embedding-v4
EMBED_DIM=1024

# ---- 对话模型：deepseek 或 qwen ----
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# DEEPSEEK_MODEL=deepseek-chat
# QWEN_MODEL=qwen-plus

# ---- 仅本地：指向 PDF 根目录，前端会多出"本地 PDF"按钮。线上留空 ----
# Windows 注意用正斜杠或双反斜杠
# LOCAL_PDF_ROOT=D:/DataBase/PDFs
